<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="160dp"
    android:orientation="vertical"
    android:paddingStart="17dp"
    android:paddingEnd="17dp"
    android:paddingTop="16dp"
    android:paddingBottom="15dp">
    <com.tjg.twidget.brief.BriefStreakValueRow
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:orientation="horizontal"
        android:gravity="center">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/brief_streak_icon"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:src="@drawable/ic_brief_streak_fire"
            android:contentDescription="@null"
            app:tint="@color/oneui_text_primary" />
        <com.tjg.twidget.ui.CardValueTextView
            android:id="@+id/brief_streak_value"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/oneui_text_primary"
            android:textSize="80sp" />
    </com.tjg.twidget.brief.BriefStreakValueRow>
    <TextView
        android:id="@+id/brief_streak_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:minHeight="19dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
