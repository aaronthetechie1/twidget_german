<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/milestone_card"
    android:layout_width="match_parent"
    android:layout_height="112dp"
    android:clipToOutline="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:minHeight="112dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <FrameLayout
            android:layout_width="76dp"
            android:layout_height="76dp">

            <com.tjg.twidget.main.MilestoneArcView
                android:id="@+id/milestone_arc"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_milestone_goals"
                app:tint="@color/oneui_text_primary" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="22dp">

            <TextView
                android:id="@+id/milestone_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sec"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="@color/oneui_text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/milestone_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:fontFamily="sec"
                android:includeFontPadding="false"
                android:lineSpacingExtra="1dp"
                android:maxLines="2"
                android:textColor="@color/oneui_text_primary"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/milestone_edit"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/milestone_edit_bg"
        android:contentDescription="@string/milestone_setup_edit"
        android:padding="4dp"
        android:src="@drawable/ic_milestone_edit"
        app:tint="@color/oneui_text_primary" />
</FrameLayout>
