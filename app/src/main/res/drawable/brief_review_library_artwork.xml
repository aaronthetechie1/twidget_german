<?xml version="1.0" encoding="utf-8"?>
<!-- Native shapes from Figma 372:11770, at its original 89 x 80 dp size. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="89dp" android:height="80dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient android:angle="270" android:startColor="@color/review_library_art_top" android:endColor="@color/review_library_art_bottom" />
        </shape>
    </item>
    <item android:width="12dp" android:height="12dp" android:left="6dp" android:top="6dp" android:gravity="top|left">
        <shape><solid android:color="@color/review_library_art_detail" /><corners android:radius="10dp" /></shape>
    </item>
    <item android:width="32dp" android:height="6dp" android:left="23dp" android:top="6dp" android:gravity="top|left">
        <shape><solid android:color="@color/review_library_art_detail" /><corners android:radius="15dp" /></shape>
    </item>
    <item android:width="21dp" android:height="4dp" android:left="23dp" android:top="14dp" android:gravity="top|left">
        <shape><solid android:color="@color/review_library_art_detail" /><corners android:radius="15dp" /></shape>
    </item>
    <item android:width="73dp" android:height="6dp" android:left="6dp" android:top="22dp" android:gravity="top|left">
        <shape><solid android:color="@color/review_library_art_detail" /><corners android:radius="15dp" /></shape>
    </item>
    <item android:width="55dp" android:height="6dp" android:left="6dp" android:top="31dp" android:gravity="top|left">
        <shape><solid android:color="@color/review_library_art_detail" /><corners android:radius="15dp" /></shape>
    </item>
    <item android:width="77dp" android:height="29dp" android:left="6dp" android:top="45dp" android:gravity="top|left">
        <shape><solid android:color="@color/review_library_art_detail" /><corners android:radius="6dp" /></shape>
    </item>
</layer-list>
