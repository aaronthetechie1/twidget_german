<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/milestone_setup_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/oneui_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/milestone_back"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/back"
                    android:padding="13dp"
                    android:scaleType="centerInside" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:fontFamily="sec"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:text="@string/milestone_account_goals"
                    android:textColor="@color/oneui_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="50dp"
                    android:layout_height="match_parent" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/milestone_metric_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/milestone_goal_group_bg"
                android:clipToOutline="true"
                android:orientation="vertical"
                android:outlineProvider="background" />

            <LinearLayout
                android:id="@+id/milestone_auto_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/milestone_goal_group_bg"
                android:clickable="true"
                android:clipToOutline="true"
                android:focusable="true"
                android:foreground="@drawable/milestone_goal_group_ripple"
                android:gravity="center_vertical"
                android:minHeight="123dp"
                android:orientation="horizontal"
                android:outlineProvider="background"
                android:paddingStart="20dp"
                android:paddingTop="18dp"
                android:paddingEnd="20dp"
                android:paddingBottom="18dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sec"
                        android:includeFontPadding="false"
                        android:text="@string/milestone_auto_adjust"
                        android:textColor="@color/oneui_text_primary"
                        android:textSize="18sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="sec"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/milestone_auto_adjust_summary"
                        android:textColor="@color/oneui_text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/milestone_auto_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
