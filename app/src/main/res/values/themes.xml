<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Twidget" parent="OneUITheme">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="colorPrimary">@color/oneui_accent</item>
        <item name="drawerBackgroundColor">@color/oneui_drawer_bg</item>
        <item name="drawerSelectedBackgroundColor">@color/oneui_drawer_selected_bg</item>
    </style>

    <!-- Figma Settings typography applied to the existing One UI components. -->
    <style name="Theme.Twidget.Settings" parent="Theme.Twidget">
        <item name="listPreferredItemHeightSmall">@dimen/settings_row_height</item>
        <item name="android:listPreferredItemHeightSmall">@dimen/settings_row_height</item>
        <item name="android:listPreferredItemPaddingStart">@dimen/settings_content_inset</item>
        <item name="android:listPreferredItemPaddingEnd">@dimen/settings_content_inset</item>
        <item name="textAppearanceListItem">@style/TextAppearance.Twidget.Settings.Title</item>
        <item name="android:textAppearanceListItem">@style/TextAppearance.Twidget.Settings.Title</item>
        <item name="android:textAppearanceSmall">@style/TextAppearance.Twidget.Settings.Summary</item>
    </style>
    <style name="TextAppearance.Twidget.Settings.Title" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:fontFamily">@font/one_ui_sans</item>
    </style>
    <style name="TextAppearance.Twidget.Settings.Summary" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
        <item name="android:fontFamily">@font/one_ui_sans</item>
    </style>

    <style name="Theme.Twidget.Launcher" parent="Theme.Twidget" />

    <style name="WidgetPresetButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">2</item>
        <item name="android:minWidth">72dp</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:textColor">?android:textColorPrimary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="SettingsRadioRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/settings_row_height</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">@dimen/settings_content_inset</item>
    </style>

    <style name="TwidgetBriefSectionLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sec</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:paddingStart">19dp</item>
        <item name="android:paddingEnd">19dp</item>
        <item name="android:textColor">@color/oneui_text_primary</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
